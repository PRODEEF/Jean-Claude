# ─────────────────────────────────────────────────────────────
# Jean-Claude — variables d'environnement
# Copier en `.env` et remplir. Ne jamais committer le `.env`.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=3000

# Origines autorisées, séparées par des virgules.
# `*` toléré en dev uniquement — interdit en production (cf. configuration.ts).
CORS_ORIGIN=http://localhost:8081

# ── Supabase ─────────────────────────────────────────────────
# Région à choisir en EU (eu-west-3 Paris / eu-central-1 Francfort) pour
# préparer la migration RGPD du §8 sans surcoût.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Moteur IA (§5.1) ─────────────────────────────────────────
# Fournisseur actif. Valeurs: claude | mistral | deepseek
# Ajouter un fournisseur = implémenter LlmProvider + l'enregistrer,
# sans toucher au reste de l'application.
LLM_PROVIDER=claude
LLM_MODEL=claude-opus-5

ANTHROPIC_API_KEY=

# Fournisseurs additionnels — hors périmètre du sprint 10 jours.
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=

# ── Vocal (§12.3 / A.12) ─────────────────────────────────────
# Laisser vide en V1 : l'app utilise les moteurs natifs iOS/Android.
SPEECH_PROVIDER=native
SPEECH_API_KEY=

# ── 2FA SMS (§6.2 — étape 2) ─────────────────────────────────
SMS_PROVIDER=
SMS_API_KEY=

# ── App (Expo) ───────────────────────────────────────────────
# Préfixe EXPO_PUBLIC_ = exposé au client. N'y mettre aucun secret.
EXPO_PUBLIC_API_URL=http://localhost:3000
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
