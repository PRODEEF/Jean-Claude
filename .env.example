# ─────────────────────────────────────────────────────────────
# Jean-Claude — variables d'environnement
# Copier en `.env` et remplir. Ne jamais committer le `.env`.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=3000

# Origines autorisées, séparées par des virgules.
# `*` toléré en dev uniquement — interdit en production (cf. configuration.ts).
CORS_ORIGIN=http://localhost:8081

# ── Supabase ─────────────────────────────────────────────────
# Région à choisir en EU (eu-west-3 Paris / eu-central-1 Francfort) pour
# préparer la migration RGPD du §8 sans surcoût.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Moteur IA (§5.1) ─────────────────────────────────────────
# Tout passe par Vercel AI Gateway : une clé unique, tous les éditeurs.
# https://vercel.com/docs/ai-gateway — clé au format `vck_...`.
AI_GATEWAY_API_KEY=

# Modèle actif, au format `éditeur/modèle`. C'est la SEULE variable à
# changer pour passer d'un moteur à un autre — aucun code à écrire (§5.1).
#   anthropic/claude-opus-5     défaut, non souverain
#   mistral/mistral-large       souverain (hébergement UE, §8, §13.4.6)
#   deepseek/deepseek-chat      open source, non souverain
LLM_MODEL=anthropic/claude-opus-5

# Ne sert qu'à brancher un jour un moteur hors Gateway (auto-hébergé, Ollama).
LLM_PROVIDER=gateway

# ── Vocal (§12.3 / A.12) ─────────────────────────────────────
# Laisser vide en V1 : l'app utilise les moteurs natifs iOS/Android.
SPEECH_PROVIDER=native
SPEECH_API_KEY=

# ── 2FA SMS (§6.2 — étape 2) ─────────────────────────────────
SMS_PROVIDER=
SMS_API_KEY=

# ── App (Expo) ───────────────────────────────────────────────
# Préfixe EXPO_PUBLIC_ = exposé au client. N'y mettre aucun secret.
EXPO_PUBLIC_API_URL=http://localhost:3000
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
