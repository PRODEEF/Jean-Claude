# ─────────────────────────────────────────────────────────────
# Jean-Claude — variables d'environnement
# Copier en `.env` et remplir. Ne jamais committer le `.env`.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=3000

# Origines autorisées, séparées par des virgules.
# `*` toléré en dev uniquement — interdit en production (cf. core/config.ts).
# Une entrée peut porter un joker pour couvrir les previews Vercel, dont l’URL
# change à chaque déploiement — il ne remplace qu’un segment, sans point :
#   https://jean-claude-web.vercel.app,https://jean-claude-web-*.vercel.app
CORS_ORIGIN=http://localhost:8081

# ── Supabase ─────────────────────────────────────────────────
# Région à choisir en EU (eu-west-3 Paris / eu-central-1 Francfort) pour
# préparer la migration RGPD du §8 sans surcoût.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Moteur IA (§5.1) ─────────────────────────────────────────
# Tout passe par Vercel AI Gateway : une clé unique, tous les éditeurs.
# https://vercel.com/docs/ai-gateway — clé au format `vck_...`.
AI_GATEWAY_API_KEY=

# Modèle servi tant que l'utilisateur n'a rien choisi dans ses réglages (§5.1),
# au format `éditeur/modèle` — aucun code à écrire pour en changer.
#   anthropic/claude-sonnet-5   défaut, non souverain
#   mistral/mistral-small       souverain (hébergement UE, §8, §13.4.6)
#   deepseek/deepseek-v3.2      open source, non souverain
#
# Le choix de l'utilisateur, lui, se limite au catalogue de
# `packages/domain/src/user/preferences.schema.ts`. Cette variable n'y est pas
# tenue : elle peut désigner un modèle qu'on éprouve avant de le proposer.
LLM_MODEL=anthropic/claude-sonnet-5

# ── Vocal (§12.3 / A.12) ─────────────────────────────────────
# Laisser vide en V1 : l'app utilise les moteurs natifs iOS/Android.
SPEECH_PROVIDER=native
SPEECH_API_KEY=

# ── 2FA SMS (§6.2 — étape 2) ─────────────────────────────────
SMS_PROVIDER=
SMS_API_KEY=

# ── App (Expo) ───────────────────────────────────────────────
# Préfixe EXPO_PUBLIC_ = exposé au client. N'y mettre aucun secret.
EXPO_PUBLIC_API_URL=http://localhost:3000
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
